{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/PointsBalance",
  "title": "PointsBalance",
  "type": "object",
  "properties": {
    "accountId": {
      "type": "string"
    },
    "totalPoints": {
      "type": "integer"
    },
    "redeemablePoints": {
      "type": "integer"
    },
    "pendingPoints": {
      "type": "integer"
    },
    "expiringPoints": {
      "type": "integer"
    },
    "expiryDate": {
      "type": "string",
      "format": "date"
    },
    "tier": {
      "type": "string"
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time"
    }
  }
}