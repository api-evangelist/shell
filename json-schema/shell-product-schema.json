{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/Product",
  "title": "Product",
  "type": "object",
  "properties": {
    "productId": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "application": {
      "type": "string"
    },
    "viscosity": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "packagingOptions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit": {
            "type": "string"
          },
          "size": {
            "type": "number"
          },
          "price": {
            "type": "number"
          }
        }
      }
    },
    "specifications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}