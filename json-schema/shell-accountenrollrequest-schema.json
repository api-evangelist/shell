{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/AccountEnrollRequest",
  "title": "AccountEnrollRequest",
  "type": "object",
  "required": [
    "firstName",
    "lastName",
    "email"
  ],
  "properties": {
    "externalId": {
      "type": "string"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "dateOfBirth": {
      "type": "string",
      "format": "date"
    },
    "countryCode": {
      "type": "string"
    },
    "marketingConsent": {
      "type": "boolean"
    }
  }
}